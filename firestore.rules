rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isMember() {
      return request.auth != null;
    }

    function hasAdminDoc() {
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function hasAdminRoleInUsers() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
        );
    }

    function isAdmin() {
      return isMember() && (
        request.auth.token.get('admin', false) == true ||
        hasAdminDoc() ||
        hasAdminRoleInUsers()
      );
    }

    match /admins/{uid} {
      allow read: if isMember() && request.auth.uid == uid;
      allow write: if isAdmin();
    }

    match /users/{uid} {
      allow read: if isAdmin() ||
        (isMember() && request.auth.uid == uid) ||
        (isMember() &&
          request.auth.token.phone_number != null &&
          resource.data.phoneNumber == request.auth.token.phone_number);
      allow write: if isAdmin() || (isMember() && request.auth.uid == uid);
    }

    // Songs rules
    match /songs/{songId} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    // Setlists rules
    match /setlists/{setlistId} {
      allow read: if isAdmin() || (isMember() && resource.data.published == true);
      allow write: if isAdmin();
    }

    // Services collection rules
    match /services/{serviceId} {
      allow read: if isMember();
      allow write: if isAdmin();

      // Recursive rule for nested subcollections (e.g., service plans, items)
      match /{subcollection=**} {
        allow read: if isMember();
        allow write: if isAdmin();
      }
    }

    // Daily Bread collection rules
    match /daily_bread/{breadId} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    // Daily Devotion image feed rules
    match /daily_devotions/{devotionId} {
      allow read: if isMember() && (resource.data.enabled == true || isAdmin());
      allow write: if isAdmin();
    }

    // Notification feed records used by Updates-like pages
    match /notifications/{notificationId} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    // Imported bilingual offline bible chapters (cached by Firestore on device)
    match /offline_bible_chapters/{chapterId} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    // Post-login popup content (special service, highlights)
    match /app_popups/{popupId} {
      allow read: if isMember() && (resource.data.enabled == true || isAdmin());
      allow write: if isAdmin();
    }

    // Homepage content: members see enabled content; admins manage everything.
    match /homepage_hero_slides/{slideId} {
      allow read: if isMember() && (resource.data.enabled == true || isAdmin());
      allow write: if isAdmin();
    }

    match /homepage_events/{eventId} {
      allow read: if isMember() && (resource.data.enabled == true || isAdmin());
      allow write: if isAdmin();
    }

    match /homepage_action_cards/{cardId} {
      allow read: if isMember() && (resource.data.enabled == true || isAdmin());
      allow write: if isAdmin();
    }

    match /testimonials/{testimonialId} {
      // The app filters member results to enabled testimonials. Reading the
      // collection here avoids permission failures for legacy documents that
      // do not yet contain an enabled field.
      allow read: if isMember();
      allow write: if isAdmin();
    }

    match /live_streams/{streamId} {
      allow read: if isMember() && (resource.data.enabled == true || isAdmin());
      allow write: if isAdmin();
    }

    match /about_us/{aboutId} {
      allow read: if isMember() && (resource.data.enabled == true || isAdmin());
      allow write: if isAdmin();
    }

    match /media_sermons/{mediaId} { allow read: if isMember() && (resource.data.enabled == true || isAdmin()); allow write: if isAdmin(); }
    match /media_inspirational/{mediaId} { allow read: if isMember() && (resource.data.enabled == true || isAdmin()); allow write: if isAdmin(); }
    match /media_videos/{mediaId} { allow read: if isMember() && (resource.data.enabled == true || isAdmin()); allow write: if isAdmin(); }
    match /media_missionary/{mediaId} { allow read: if isMember() && (resource.data.enabled == true || isAdmin()); allow write: if isAdmin(); }
    match /media_music/{mediaId} { allow read: if isMember() && (resource.data.enabled == true || isAdmin()); allow write: if isAdmin(); }
    match /media_sunday_school/{mediaId} { allow read: if isMember() && (resource.data.enabled == true || isAdmin()); allow write: if isAdmin(); }

    match /prayer_callbacks/{requestId} {
      allow read: if isAdmin() ||
        (isMember() &&
          (
            resource.data.memberUid == request.auth.uid ||
            (request.auth.token.phone_number != null && resource.data.memberPhone == request.auth.token.phone_number)
          ));
      allow create: if isMember();
      allow update, delete: if isAdmin();
    }

    match /prayer_requests/{requestId} {
      allow read: if isAdmin() ||
        (isMember() &&
          (
            resource.data.memberUid == request.auth.uid ||
            (request.auth.token.phone_number != null && resource.data.memberPhone == request.auth.token.phone_number)
          ));
      allow create: if isMember();
      allow update, delete: if isAdmin();
    }

    match /prayer_cell/{memberId} {
      allow read: if isAdmin() ||
        (isMember() &&
          (
            resource.data.memberUid == request.auth.uid ||
            (request.auth.token.phone_number != null && resource.data.memberPhone == request.auth.token.phone_number)
          ));
      allow create: if isMember();
      allow update, delete: if isAdmin();
    }

    match /highlights/{highlightId} {
      allow read: if isMember() && (resource.data.enabled == true || isAdmin());
      allow write: if isAdmin();
    }

    match /gospel_tracts/{tractId} {
      allow read: if isMember() && (resource.data.enabled == true || isAdmin());
      allow write: if isAdmin();
    }
  }
}